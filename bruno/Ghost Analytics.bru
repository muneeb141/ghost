meta {
  name: Ghost Analytics Dashboard Data
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/method/ghost.ghost.page.ghost_analytics.ghost_analytics.get_analytics_data
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_access_token}}
}

vars:pre-request {
  baseUrl: http://localhost:8000
}

docs {
  Returns conversion analytics for the Ghost Analytics desk page.
  Requires a System Manager user's bearer token (set admin_access_token) —
  ghost tokens are not permitted. Enable conversion logging first via
  Ghost Settings > Analytics > Enable Conversion Logging.
}
