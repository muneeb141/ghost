meta {
  name: Create Ghost Session (Fingerprint)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/method/ghost.api.ghost.create_ghost_session
  body: json
  auth: none
}

body:json {
  {
    "fingerprint": "bruno_test_fingerprint_123"
  }
}


script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    // Extract OAuth Bearer tokens from response
    bru.setVar("ghost_email", data.message.user);
    bru.setVar("access_token", data.message.access_token);
    bru.setVar("ghost_access_token", data.message.access_token); // Set for Capture Lead Request
    bru.setVar("refresh_token", data.message.refresh_token);
    bru.setVar("expires_in", data.message.expires_in);
    bru.setVar("token_type", data.message.token_type);
  }
}

docs {
  The fingerprint argument is retained for compatibility but cannot authenticate or reconnect a user.
  Repeated calls create distinct anonymous identities. Save the issued credentials to resume a session.
}
