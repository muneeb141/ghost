meta {
  name: Social Login (Google)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/method/ghost.api.social.convert_with_google
  body: json
  auth: none
}

body:json {
  {
    "ghost_email": "{{ghost_email}}",
    "id_token": "{{google_id_token}}"
  }
}

headers {
  Authorization: Bearer {{ghost_access_token}}
}
